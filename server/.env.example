# Copy to .env for local use (npm run keygen fills the two secrets). On the host, set these as variables, never in a file.

# SECRET. Controls every coffin wallet. Generate with `npm run keygen -- --print`, keep it in a password manager.
MASTER_MNEMONIC=
# SECRET. Header x-admin-key for /api/admin/rooms/:id/{fill,expire,refunds,buyback}
ADMIN_KEY=

# Where the platform fee is paid. An address you control. Leave empty to charge no fee.
TREASURY_ADDRESS=
# Fee as basis points of the pool, taken only when a coffin relaunches. 200 = 2%, capped at 500.
FEE_BPS=200
# Set once the platform token exists: that share (basis points) of each net fee buys it and burns it.
PLATFORM_TOKEN=
BURN_SHARE_BPS=5000

# Public address of the site, no trailing slash. Turns on /sitemap.xml and canonical links.
SITE_URL=
# Only needed if the web app is served from a different address than the API.
CORS_ORIGIN=*

# Robinhood Chain mainnet (default). Change both for another chain.
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Where the database lives. On Railway attach a Volume and either set DATA_DIR to its mount path or just attach it.
DATA_DIR=data
