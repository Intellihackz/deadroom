{
  "name": "deadroom-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "check": "tsx --env-file-if-exists=.env scripts/check-chain.ts",
    "keygen": "tsx scripts/keygen.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
